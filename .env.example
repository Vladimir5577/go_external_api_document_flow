# local | dev | prod — влияет только на формат логов
ENV=local

# Порт HTTP-сервера микросервиса (8085 занят канбаном, 8086 — уведомлениями)
SERVER_PORT=8087

# Путь к публичному ключу RSA для проверки подписи JWT.
# В docker-compose переопределяется на /config/jwt/public.pem
JWT_PUBLIC_KEY_PATH=../symfony_documents_flow/config/jwt/public.pem

# Внешний сервис don_snab — единственный upstream.
# Значения взять из symfony_documents_flow/.env (DON_SNAB_API_URL, DON_SNAB_API_KEY)
DON_SNAB_API_URL=
DON_SNAB_API_KEY=

# Таймаут одного запроса к don_snab, секунды
UPSTREAM_TIMEOUT_SECONDS=30

# Микросервис голосовой почты (go_voicemail_service_document_flow).
# Шлюз только проксирует в него запросы, проверив JWT и роль; на саму АТС
# ходит микросервис, поэтому VMAPI_URL и VMAPI_TOKEN здесь больше не нужны —
# они переехали в .env микросервиса.
# Доступен по внутренней сети voicemail-net, наружу порт не проброшен.
VOICEMAIL_SERVICE_URL=http://voicemail_service:8089

# Кириллические TTF для выгрузки в PDF (пакет fonts-dejavu-core).
# В образ ставятся Dockerfile-ом, локально — apt install fonts-dejavu-core
PDF_FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
PDF_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Таймзона для дат, которые upstream отдаёт без смещения.
# Должна совпадать с date.timezone в PHP-контейнере монолита.
APP_TIMEZONE=Europe/Moscow
